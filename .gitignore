# env files — never commit ANY env file (real secrets OR *.example templates)
.env
.env.*
*.env
frontend/.env
backend/.env

# Docker — committed build infra: docker-compose.prod.yml and the backend build
# context (backend/Dockerfile is tracked; backend/.dockerignore is re-included
# below so the build context stays hygienic). Any OTHER stray Docker file stays
# ignored so it can't confuse the Coolify deployment.
Dockerfile
*.dockerfile
.dockerignore
docker-compose*.yml
!docker-compose.prod.yml
!backend/.dockerignore
!backend/Dockerfile

# Local agent / editor tooling — never part of the app
.claude/
.agents/

# dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# builds
.next/
frontend/.next/
dist/
build/
out/
*.tsbuildinfo

# python
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/
backend/venv/
.pytest_cache/
backend/.pytest_cache/
backend/pytest-cache-files-*/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local machine artifacts — not part of the app, leaks local paths/username
source_file_list.txt

# Business & marketing material — kept locally, never published with the code
LINKEDIN_COPY.md
LINKEDIN_COMPANY_PAGE.md
ParchiVisa_PitchDeck.pptx

# Stray root lockfile — the real ones are frontend/package-lock.json and
# backend/requirements*.txt; nothing is installed from the repo root
/package-lock.json
