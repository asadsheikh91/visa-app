# env files — never commit ANY env file (real secrets OR *.example templates)
.env
.env.*
*.env
frontend/.env
backend/.env

# Docker — ONLY docker-compose.prod.yml is committed. Every other Docker file
# (Dockerfiles, .dockerignore, other compose files) is excluded so it can't
# confuse the Coolify deployment.
Dockerfile
*.dockerfile
.dockerignore
docker-compose*.yml
!docker-compose.prod.yml

# Local agent / editor tooling — never part of the app
.claude/

# dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# builds
.next/
frontend/.next/
dist/
build/
out/

# python
__pycache__/
*.pyc
.venv/
venv/
backend/.venv/
backend/venv/
.pytest_cache/
backend/.pytest_cache/
backend/pytest-cache-files-*/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local machine artifacts — not part of the app, leaks local paths/username
source_file_list.txt
