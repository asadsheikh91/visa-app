# Copy this file to .env.local and fill in your real values
# Never commit .env.local to git

# ── Backend ─────────────────────────────────────────────────────────────────
# URL of the running FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (defaults work for local dev; update for production)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Notes ────────────────────────────────────────────────────────────────────
# If NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is not set, Clerk UI will not render.
# The Student Visa Checker still works in demo mode without Clerk keys,
# but sign-in / sign-up buttons will be hidden / inert.
