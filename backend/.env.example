# ─── Environment ─────────────────────────────────────────────────────────────
# "development" (default) | "staging" | "production". Only "production" changes
# behaviour: it disables the interactive API docs (/docs, /redoc) and the OpenAPI
# schema (/openapi.json) so the API surface isn't publicly enumerable. Leave unset
# locally; set ENVIRONMENT=production in the prod deployment.
ENVIRONMENT=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local: use docker-compose. Production: Railway / Supabase PostgreSQL URL.
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5433/Visa

# ─── Authentication — Clerk ───────────────────────────────────────────────────
# Clerk Dashboard → API Keys → Advanced → JWKS URL
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
# Clerk Secret Key (sk_...). Lets the backend resolve a user's email from Clerk's
# API when the session token has no email claim. Required to store email reliably.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Dev default (if omitted): http://localhost:3000
# Production example: https://parchivisa.com,https://www.parchivisa.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── AI features — Anthropic Claude ───────────────────────────────────────────
# Powers the SOP reviewer and mock-interview simulator. Get a key at
# https://console.anthropic.com/. If unset, those endpoints return 503 and the
# frontend shows a graceful "coming soon / unavailable" message — every other
# feature keeps working.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-4-8 (highest quality).
# For lower cost set: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-opus-4-8

# ─── AI — Gemini (Readiness Report narration) ────────────────────────────────
# Narrates ONLY the four per-finding prose fields of the Readiness Report, in
# schema-locked JSON mode (it never originates a number, severity, or finding).
# If unset, report generation still works using deterministic templated prose.
# Get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Optional Flash-tier model override. Verify the current id against Gemini docs.
GEMINI_MODEL=gemini-2.5-flash

# ─── Field encryption — bank-statement PII at rest ───────────────────────────
# REQUIRED for the Bank Statement Checker. Encrypts UserDocument.extracted
# (balances, account holder, bank name) before it is written to the database, so
# a DB/backup compromise yields only ciphertext. Without it, /api/visa/documents
# /financial/evaluate returns 503 (it refuses to store this PII as plaintext).
# Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret, never commit the real value, and rotating it makes existing
# encrypted rows unreadable.
FIELD_ENCRYPTION_KEY=

# ─── Cache — Redis ────────────────────────────────────────────────────────────
# Optional but strongly recommended in production.
# If unset, every uncached request fetches directly from R2.
# Local: redis://localhost:6379/0  |  Production: your Redis provider URL.
REDIS_URL=redis://localhost:6379/0

# ─── Currency conversion — open.er-api.com (keyless) ─────────────────────────
# Estimated currency conversion for visa-readiness financial (proof-of-funds)
# checks now uses open.er-api.com (ExchangeRate-API's free open-access endpoint).
# NO API KEY IS REQUIRED — there is nothing to configure here. It is used because
# it carries PKR, which ECB-based feeds (e.g. Frankfurter) do not.
# Rates are cached in Redis (key: currency:rate:PKR:GBP, TTL 6h) when REDIS_URL
# is configured; otherwise each request fetches from the provider directly.
# (EXCHANGE_RATE_API_KEY is no longer used and can be removed from your env.)

# ─── Cloudflare R2 — visa data storage ───────────────────────────────────────
# R2 Dashboard → your bucket → Settings → S3-compatible endpoint
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=visa-app
R2_PREFIX=parchivisa-data
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# ─── Readiness Report PDF (server-side Playwright → private R2, signed URLs) ──
# Report PDFs are stored PRIVATELY in R2 and handed out only as short-lived signed
# URLs. They reuse the R2 credentials above; only the key prefix differs. Set
# R2_REPORTS_BUCKET only if you keep report PDFs in a separate bucket.
R2_REPORTS_PREFIX=parchivisa-reports
# R2_REPORTS_BUCKET=parchivisa-reports
# Origin Playwright loads to render the print route. In production set this to the
# deployed frontend URL (e.g. https://parchivisa.com).
REPORT_PRINT_BASE_URL=http://127.0.0.1:3000

# ─── Billing — Gumroad webhook → paid plan (unlocks the Readiness Report) ─────
# The Readiness Report is gated on a paid plan. Set a strong secret and append it
# to the Gumroad Ping URL, e.g.
#   https://api.parchivisa.com/api/billing/gumroad/webhook?secret=YOUR_SECRET
# On a sale the buyer's User.plan is set to GUMROAD_PLAN; on refund/dispute/
# cancellation it reverts to "free". If the secret is unset, the webhook is
# disabled (returns 503) so it can never be an open plan-grant.
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PLAN=pro
# Optional hardening — restrict which seller/product may grant access.
# GUMROAD_SELLER_ID=
# GUMROAD_PRODUCT_ID=

