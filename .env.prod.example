# Copy this to `.env` at the repo root on the Droplet (same directory as
# docker-compose.prod.yml — Compose auto-loads it). This file supplies:
#   1. Credentials for the self-hosted Postgres container
#   2. Build-time NEXT_PUBLIC_* args baked into the frontend bundle
# It is separate from backend/.env and frontend/.env.production, which hold
# the rest of each service's runtime config.

# ─── Postgres (self-hosted container) ────────────────────────────────────────
POSTGRES_USER=parchivisa
POSTGRES_PASSWORD=change-me-to-a-strong-random-value
POSTGRES_DB=parchivisa

# ─── Frontend build args (must match frontend/.env.production) ──────────────
NEXT_PUBLIC_API_URL=https://api.parchivisa.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
NEXT_PUBLIC_AI_TOOLS_ENABLED=false
NEXT_PUBLIC_AGENCY_ENABLED=false
